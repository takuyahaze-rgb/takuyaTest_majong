@* 副露 1 組の表示。暗槓は両端を裏向きにする。 *@
@using Mahjong.Core

<span class="meld">
    @for (int i = 0; i < Meld.Tiles.Count; i++)
    {
        bool back = Meld.Type == MeldType.Ankan && (i == 0 || i == Meld.Tiles.Count - 1);
        <TileImage Tile="@(back ? null : Meld.Tiles[i])" CssClass="@TileClass" />
    }
</span>

@code {
    [Parameter, EditorRequired] public Meld Meld { get; set; } = default!;

    /// <summary>牌に付ける CSS クラス(大きさの指定)。</summary>
    [Parameter] public string TileClass { get; set; } = "small";
}
