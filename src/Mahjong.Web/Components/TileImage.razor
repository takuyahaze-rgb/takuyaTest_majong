@* 牌 1 枚の簡単な絵(SVG)。Tile が null なら裏向き。 *@
@using Mahjong.Core

<svg class="tile @CssClass" viewBox="0 0 60 80" role="img" aria-label="@Label" @onclick="OnClick">
    @if (Tile is not Tile t)
    {
        <rect x="1.5" y="1.5" width="57" height="77" rx="7" fill="#2f7d5b" stroke="#1d5139" stroke-width="3" />
    }
    else
    {
        <rect x="1.5" y="1.5" width="57" height="77" rx="7" fill="#fbf8ee" stroke="#9a8f74" stroke-width="3" />
        @switch (t.Suit)
        {
            case Suit.Man:
                @* Razor のコード中で <text> を直接書くと Razor の特別なタグになるため、<g> で包む *@
                <g>
                    <text x="30" y="34" text-anchor="middle" font-size="28" font-weight="bold" fill="@(t.IsRed ? Red : Ink)">@ManNumbers[t.Number - 1]</text>
                    <text x="30" y="70" text-anchor="middle" font-size="28" font-weight="bold" fill="@Red">萬</text>
                </g>
                break;

            case Suit.Pin:
                foreach (var (cx, cy) in PinPositions[t.Number - 1])
                {
                    double r = PinRadius(t.Number);
                    string color = t.IsRed || t.Number == 1 ? Red : (cx + cy) % 2 == 0 ? Blue : Green;
                    <circle cx="@cx" cy="@cy" r="@r" fill="@color" />
                    <circle cx="@cx" cy="@cy" r="@(r * 0.5)" fill="#fbf8ee" />
                }
                break;

            case Suit.Sou when t.Number == 1:
                <rect x="24" y="12" width="12" height="56" rx="6" fill="@(t.IsRed ? Red : Green)" />
                <circle cx="30" cy="16" r="7" fill="@Red" />
                break;

            case Suit.Sou:
                foreach (var (cx, cy) in SouPositions[t.Number - 1])
                {
                    string color = t.IsRed ? Red : t.Number is 7 or 9 && cy == SouPositions[t.Number - 1][0].Y && cx == 30 ? Red : Green;
                    <rect x="@(cx - 3)" y="@(cy - 10)" width="6" height="20" rx="3" fill="@color" />
                }
                break;

            default:
                if (t.Kind == (int)TileKind.White)
                {
                    <rect x="12" y="14" width="36" height="52" rx="3" fill="none" stroke="@Blue" stroke-width="3" />
                }
                else
                {
                    <g>
                        <text x="30" y="54" text-anchor="middle" font-size="38" font-weight="bold" fill="@HonorColor(t.Kind)">@TileKinds.ToDisplay(t.Kind)</text>
                    </g>
                }
                break;
        }
    }
</svg>

@code {
    /// <summary>表示する牌(null なら裏向き)。</summary>
    [Parameter] public Tile? Tile { get; set; }

    /// <summary>大きさ・状態を表す CSS クラス(例: "small", "selected", "dim")。</summary>
    [Parameter] public string? CssClass { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }

    private const string Ink = "#222";
    private const string Red = "#c62828";
    private const string Blue = "#1565c0";
    private const string Green = "#2e7d32";

    private static readonly string[] ManNumbers = ["一", "二", "三", "四", "五", "六", "七", "八", "九"];

    private string Label => Tile is Tile t ? (t.IsRed ? "赤" : "") + TileKinds.ToDisplay(t.Kind) : "裏";

    private static string HonorColor(int kind) => kind switch
    {
        (int)TileKind.Green => Green,
        (int)TileKind.Red => Red,
        _ => Ink,
    };

    private static double PinRadius(int n) => n switch { 1 => 17, <= 4 => 10, <= 6 => 9, _ => 7.5 };

    // 筒子の丸の位置(1〜9)
    private static readonly (int X, int Y)[][] PinPositions =
    [
        [(30, 40)],
        [(30, 22), (30, 58)],
        [(15, 17), (30, 40), (45, 63)],
        [(18, 22), (42, 22), (18, 58), (42, 58)],
        [(17, 19), (43, 19), (30, 40), (17, 61), (43, 61)],
        [(19, 16), (41, 16), (19, 40), (41, 40), (19, 64), (41, 64)],
        [(13, 13), (30, 21), (47, 29), (19, 49), (41, 49), (19, 67), (41, 67)],
        [(19, 13), (41, 13), (19, 31), (41, 31), (19, 49), (41, 49), (19, 67), (41, 67)],
        [(13, 16), (30, 16), (47, 16), (13, 40), (30, 40), (47, 40), (13, 64), (30, 64), (47, 64)],
    ];

    // 索子の棒の中心位置(2〜9。1 は別に描く)
    private static readonly (int X, int Y)[][] SouPositions =
    [
        [],
        [(30, 22), (30, 58)],
        [(30, 22), (18, 58), (42, 58)],
        [(18, 22), (42, 22), (18, 58), (42, 58)],
        [(16, 22), (44, 22), (30, 40), (16, 58), (44, 58)],
        [(14, 22), (30, 22), (46, 22), (14, 58), (30, 58), (46, 58)],
        [(30, 14), (14, 40), (30, 40), (46, 40), (14, 66), (30, 66), (46, 66)],
        [(12, 22), (24, 22), (36, 22), (48, 22), (12, 58), (24, 58), (36, 58), (48, 58)],
        [(14, 14), (30, 14), (46, 14), (14, 40), (30, 40), (46, 40), (14, 66), (30, 66), (46, 66)],
    ];
}
